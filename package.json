{
  "name": "one",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "dev:blogger": "turbo dev --filter=@one/blogger",
    "dev:vite-react": "turbo dev --filter=@one/vite-react",
    "dev:node-service": "turbo dev --filter=@one/node-service",
    "dev:worker-api": "turbo dev --filter=@one/worker-api",
    "dev:faceless": "turbo dev --filter=@one/faceless",
    "db:generate": "pnpm --filter @one/worker-api db:generate",
    "db:migrate:local": "pnpm --filter @one/worker-api db:migrate:local",
    "db:migrate:remote": "pnpm --filter @one/worker-api db:migrate:remote",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,md}\"",
    "clean": "turbo clean"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.20.0",
    "prettier": "^3.5.0",
    "turbo": "^2.5.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.25.0"
  },
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=22"
  }
}
