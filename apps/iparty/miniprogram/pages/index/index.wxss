.home {
  padding: 24rpx 40rpx calc(56rpx + env(safe-area-inset-bottom));
}
.brand-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}
.brand {
  font-size: 88rpx;
  font-weight: 700;
  line-height: 1.15;
  letter-spacing: -5rpx;
}
.brand-dot {
  color: #b88253;
}
.nav-link {
  flex-shrink: 0;
  padding: 16rpx 0 16rpx 20rpx;
  font-size: 23rpx;
}
.hero {
  padding-top: 76rpx;
}
.headline {
  display: block;
  margin: 0;
  font-size: 72rpx;
  font-weight: 600;
  line-height: 1.32;
  letter-spacing: -2rpx;
}
.accent {
  display: block;
  color: #65805a;
}
.hero-services {
  display: block;
  margin-top: 32rpx;
  color: #8e795b;
  font-size: 23rpx;
  font-weight: 500;
  line-height: 1.8;
  letter-spacing: 1rpx;
}
.hero-description {
  margin-top: 28rpx;
  display: block;
  color: #7b8274;
  font-size: 27rpx;
  line-height: 1.95;
}
.hero-actions {
  display: flex;
  margin-top: 44rpx;
}
.hero-link {
  display: inline-flex;
  align-items: center;
  gap: 36rpx;
  max-width: 100%;
  padding: 12rpx 0;
  border-bottom: 2rpx solid #526d57;
  color: #244c3c;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.8;
}
.link-arrow {
  flex-shrink: 0;
  font-size: 34rpx;
  font-weight: 400;
}
.hero-link-hover {
  opacity: 0.65;
}
.hero-summary {
  display: flex;
  gap: 16rpx;
  margin-top: 60rpx;
  padding: 30rpx 0;
  border-top: 2rpx solid #e2e6d5;
  border-bottom: 2rpx solid #e2e6d5;
}
.hero-summary > view {
  flex: 1;
  min-width: 0;
}
.summary-title,
.summary-caption {
  display: block;
}
.summary-title {
  font-size: 28rpx;
  font-weight: 600;
}
.summary-caption {
  margin-top: 12rpx;
  color: #8b927f;
  font-size: 21rpx;
  line-height: 1.7;
}
.workflow-section {
  margin-top: 120rpx;
  padding: 44rpx 32rpx 52rpx;
  border-radius: 28rpx;
  background: #edf0e5;
}
.workflow-section .eyebrow {
  font-size: 21rpx;
  line-height: 1.8;
  letter-spacing: 2rpx;
}
.section-heading {
  display: block;
  margin: 22rpx 0 24rpx;
  font-size: 44rpx;
  font-weight: 600;
  line-height: 1.5;
  letter-spacing: -1rpx;
}
.heading-line {
  display: block;
}
.steps {
  margin-top: 48rpx;
}
.step {
  display: flex;
  gap: 24rpx;
  margin-top: 40rpx;
}
.step:first-child {
  margin-top: 0;
}
.step-number {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  border: 2rpx solid #cbd6c0;
  border-radius: 50%;
  color: #65805a;
  font-size: 22rpx;
}
.step-content {
  flex: 1;
  min-width: 0;
}
.step-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 48rpx;
}
.step-description {
  display: block;
  margin-top: 10rpx;
  color: #7b8274;
  font-size: 25rpx;
  line-height: 1.85;
}
.site-footer {
  margin-top: 120rpx;
  padding-top: 44rpx;
  border-top: 2rpx solid #e2e6d5;
}
.footer-brand {
  font-size: 38rpx;
  font-weight: 700;
  letter-spacing: -2rpx;
}
.footer-tagline,
.footer-note {
  display: block;
  color: #8b927f;
  line-height: 1.8;
}
.footer-tagline {
  margin-top: 18rpx;
  font-size: 24rpx;
}
.footer-note {
  margin-top: 30rpx;
  font-size: 20rpx;
}
.entry-loading {
  display: flex;
  min-height: 100vh;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
}
.entry-spinner {
  width: 36rpx;
  height: 36rpx;
  border: 3rpx solid #e2e6d5;
  border-top-color: #65805a;
  border-radius: 50%;
  animation: entry-spin 0.8s linear infinite;
}
.entry-loading-text {
  color: #8b927f;
  font-size: 24rpx;
  line-height: 1.6;
}
@keyframes entry-spin {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}
.entry-state {
  padding-top: 180rpx;
}
