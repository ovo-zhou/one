.management {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}
.management-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  min-height: 168rpx;
  padding: 32rpx;
}
.card-content {
  flex: 1;
  min-width: 0;
}
.card-title,
.card-description {
  display: block;
}
.card-title {
  font-size: 32rpx;
  font-weight: 600;
}
.card-description {
  margin-top: 12rpx;
  color: #7b8274;
  font-size: 24rpx;
  line-height: 1.6;
}
.card-arrow {
  flex-shrink: 0;
  color: #55704f;
  font-size: 32rpx;
}
