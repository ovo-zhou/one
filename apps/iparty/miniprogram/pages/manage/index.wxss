.shop-summary {
  padding: 32rpx;
  background: #eaf0df;
}
.shop-name {
  display: block;
  margin: 22rpx 0 12rpx;
  font-size: 36rpx;
  font-weight: 600;
}
.appointment-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin: 24rpx 0;
  padding: 28rpx;
  border-radius: 20rpx;
  background: #f0ebdb;
  color: #8a6f47;
  font-size: 23rpx;
}
.entry-title,
.entry-note {
  display: block;
}
.entry-title {
  margin-bottom: 8rpx;
  font-size: 27rpx;
  font-weight: 600;
}
.entry-note {
  font-size: 21rpx;
}
.manage-grid {
  display: flex;
  gap: 20rpx;
}
.manage-item {
  flex: 1;
  min-width: 0;
  padding: 26rpx;
}
.item-symbol {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 66rpx;
  height: 66rpx;
  margin-bottom: 24rpx;
  border-radius: 18rpx;
  background: #edf0e4;
  font-size: 28rpx;
}
.item-title {
  display: block;
  margin-bottom: 14rpx;
  font-size: 28rpx;
  font-weight: 600;
}
.item-link {
  display: block;
  margin-top: 30rpx;
  color: #55704f;
  font-size: 23rpx;
}
.connection {
  margin-top: 30rpx;
  text-align: center;
}
