<view class="page management">
  <view wx:if="{{role === 'merchant'}}" class="card management-card" bindtap="editShop" role="button" aria-label="店铺管理">
    <view class="card-content"><text class="card-title">店铺管理</text><text class="card-description">编辑店铺介绍、地址与联系方式</text></view>
    <text class="card-arrow">→</text>
  </view>
  <view wx:if="{{role === 'merchant'}}" class="card management-card" bindtap="openStaff" role="button" aria-label="服务人员管理">
    <view class="card-content"><text class="card-title">服务人员管理</text><text class="card-description">添加、编辑和预览服务人员资料</text></view>
    <text class="card-arrow">→</text>
  </view>
  <view wx:if="{{role === 'merchant'}}" class="card management-card" bindtap="openAppointments" role="button" aria-label="预约管理">
    <view class="card-content"><text class="card-title">预约管理</text><text class="card-description">查看、确认和处理客户预约</text></view>
    <text class="card-arrow">→</text>
  </view>
  <view class="card management-card" bindtap="openMyBookings" role="button" aria-label="我的预约">
    <view class="card-content"><text class="card-title">我的预约</text><text class="card-description">查看我向其他店铺提交的预约</text></view>
    <text class="card-arrow">→</text>
  </view>
  <button wx:if="{{role === 'customer'}}" class="text-button" bindtap="createShop">创建我的店铺</button>
  <view wx:if="{{error}}" class="local-notice">{{error}}</view>
  <view>
    <text wx:if="{{loading}}" class="hint">正在确认账号身份…</text>
    <button wx:if="{{role === 'super_admin'}}" class="text-button" bindtap="openAdmin">进入平台管理</button>
  </view>
</view>
