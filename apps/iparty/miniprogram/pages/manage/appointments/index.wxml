<view class="page">
  <view class="local-notice">预约为意向申请，请先与客户核实档期。店铺停用后不能确认新预约，但仍可拒绝申请或完成历史预约。</view>
  <view wx:if="{{error}}" class="local-notice">{{error}}<button class="text-button" bindtap="retry">刷新重试</button></view>
  <view wx:for="{{items}}" wx:key="id" class="card record">
    <text class="record-title">{{item.staffName}} · {{item.staffTitle}}</text><text class="record-status">{{item.statusLabel}}</text><text class="record-line">意向时间：{{item.timeLabel}}</text>
    <text class="record-line">联系人：{{item.contactName}} · {{item.contactPhone}}</text><text class="record-line">备注：{{item.note || '无'}}</text><text class="hint">提交于 {{item.createdLabel}}</text>
    <view class="record-actions"><button class="text-button" data-id="{{item.id}}" bindtap="call">联系客户</button>
      <button wx:if="{{item.status === 'pending'}}" class="text-button" data-id="{{item.id}}" data-status="confirmed" bindtap="change" disabled="{{saving}}">确认</button>
      <button wx:if="{{item.status === 'pending'}}" class="text-button" data-id="{{item.id}}" data-status="rejected" bindtap="change" disabled="{{saving}}">拒绝</button>
      <button wx:if="{{item.status === 'confirmed'}}" class="text-button" data-id="{{item.id}}" data-status="completed" bindtap="change" disabled="{{saving}}">标记完成</button>
    </view>
  </view>
  <view wx:if="{{!loading && !error && !items.length}}" class="empty muted">暂无客户预约</view>
  <text wx:if="{{loading}}" class="muted">正在加载…</text><button wx:elif="{{hasMore}}" class="text-button" bindtap="more">加载更多</button>
</view>
