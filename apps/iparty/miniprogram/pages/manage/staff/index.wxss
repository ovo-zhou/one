page {
  height: 100%;
  overflow: hidden;
}
.staff-management {
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
}
.staff-scroll {
  flex: 1;
  height: 0;
  min-height: 0;
}
.staff-list {
  padding: 36rpx;
}
.staff-card {
  margin-bottom: 24rpx;
}
.staff-card:last-child {
  margin-bottom: 0;
}
.staff-footer {
  flex-shrink: 0;
  padding: 24rpx 36rpx calc(24rpx + env(safe-area-inset-bottom));
  border-top: 2rpx solid #e9ecdf;
  background: #f7f7ef;
}
.staff-footer button.add-staff {
  display: block;
  width: 100%;
  max-width: none;
  margin: 0;
}
.person-row {
  display: flex;
  align-items: center;
  gap: 22rpx;
}
.initial {
  width: 92rpx;
  height: 112rpx;
  overflow: hidden;
  font-size: 23rpx;
}
.person-info {
  flex: 1;
  min-width: 0;
}
.person-name {
  display: block;
  margin-bottom: 8rpx;
  font-size: 31rpx;
  font-weight: 600;
}
.actions {
  display: flex;
  justify-content: space-around;
  margin-top: 26rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid #edf0e5;
}
.delete {
  color: #a57361;
}
