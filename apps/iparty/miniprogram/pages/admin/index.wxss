@import "../../styles/records.wxss";

.search-controls {
  margin-bottom: 30rpx;
}
.search-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.status-picker {
  flex: 1;
  min-width: 0;
}
.input.filter {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 40px;
}
.search-row .search-button {
  flex: 0 0 152rpx;
  width: 152rpx;
  margin: 0;
  padding: 0;
  border-radius: 16rpx;
}
.shop-card-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}
.shop-card-heading .record-title {
  flex: 1;
  min-width: 0;
  margin: 0;
  word-break: break-all;
}
.shop-card-status {
  display: flex;
  flex-shrink: 0;
  flex-direction: column;
  align-items: flex-end;
  gap: 6rpx;
}
.shop-status-badge {
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: #e6ebdb;
  color: #405343;
  font-size: 22rpx;
  line-height: 1.5;
}
.shop-status-disabled {
  background: #f0ebdb;
  color: #896b46;
}
.shop-owner-status {
  color: #b14c38;
  font-size: 22rpx;
}
