<import src="../../../templates/form-field.wxml" />

<view class="form-page">
  <scroll-view class="form-scroll" scroll-y="{{true}}"><view class="form-content">
    <view wx:if="{{loadError}}" class="local-notice">{{loadError}}<button class="text-button" bindtap="refresh" disabled="{{saving}}">刷新资料</button></view><text wx:if="{{loading}}" class="muted">正在加载…</text>
    <block wx:if="{{shop}}">
      <view class="card record">
        <text class="record-title">{{shop.name}}</text><text class="record-status">{{shop.status === 'active' ? '正常' : '已停用'}} · 账号{{shop.ownerStatus === 'active' ? '正常' : '已禁用'}}</text>
        <text class="record-line">{{shop.description || '未填写介绍'}}</text><text wx:if="{{shop.locationName}}" class="record-line">位置：{{shop.locationName}}</text><text class="record-line">地址：{{shop.address}}{{shop.addressDetail ? ' ' + shop.addressDetail : ''}}</text>
        <text wx:if="{{shop.wechat}}" class="record-line">微信：{{shop.wechat}}</text><text wx:if="{{shop.qq}}" class="record-line">QQ：{{shop.qq}}</text><text wx:if="{{shop.phone}}" class="record-line">电话：{{shop.phone}}</text>
        <text class="record-line">营业时间：</text><block wx:if="{{hoursRows.length}}"><text wx:for="{{hoursRows}}" wx:key="index" class="record-line">{{item.daysLabel}}　{{item.timeLabel}}</text></block><text wx:else class="record-line">{{shop.legacyBusinessHours || '未填写'}}</text>
        <text class="record-line">最近平台操作原因：{{shop.statusReason || '无'}}</text><text class="hint" selectable>商家账号：{{shop.ownerId}}</text><button class="text-button" bindtap="audit">查看平台操作记录 →</button><button class="text-button" bindtap="refresh" disabled="{{loading || saving}}">刷新资料</button>
      </view>
      <text class="section-title">服务人员（{{staff.length}}）</text><text class="hint">平台内部只读资料，店铺停用后仍可查看；不会触发客户联系或预约。</text>
      <view wx:for="{{staff}}" wx:key="publicId" class="card record"><text class="record-title">{{item.name}} · {{item.title}}</text><text class="record-line">擅长项目：{{item.skills}}</text><text class="record-line">详细介绍：{{item.description || '未填写'}}</text></view>
      <view wx:if="{{!staff.length}}" class="empty muted">暂无服务人员</view>
      <view class="field">
        <template is="field-heading" data="{{label: '本次平台操作原因', required: true, description: '停用和恢复的原因都会记录到操作日志。'}}" />
        <textarea class="textarea" maxlength="300" value="{{reason}}" bindinput="inputReason" disabled="{{saving}}" placeholder="填写操作原因" />
        <template is="field-error" data="{{message: reasonError}}" />
      </view>
    </block>
  </view></scroll-view>
  <view wx:if="{{shop && !loading && !loadError}}" class="form-footer">
    <view wx:if="{{formError}}">
      <text class="form-error" aria-role="alert">{{formError}}</text>
    </view>
    <button class="primary" bindtap="change" disabled="{{saving}}" loading="{{saving}}">{{shop.status === 'active' ? '停用店铺' : '恢复店铺'}}</button>
  </view>
</view>
