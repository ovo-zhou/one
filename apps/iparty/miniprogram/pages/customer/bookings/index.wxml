<view class="page">
  <view wx:if="{{error}}" class="local-notice notice-error">{{error}}<button class="text-button" bindtap="retry">刷新重试</button></view>
  <view wx:for="{{items}}" wx:key="id" class="card record" data-id="{{item.id}}" bindtap="detail" role="button">
    <text class="record-title">{{item.shopName}}</text><text class="record-line">{{item.staffName}} · {{item.staffTitle}}</text><text class="record-line">意向时间：{{item.timeLabel}}</text><text class="record-status">{{item.statusLabel}} · 查看详情 →</text>
  </view>
  <view wx:if="{{!loading && !error && !items.length}}" class="empty"><text class="empty-title">暂无预约</text><text class="muted">打开商家分享的人员名片，即可提交预约申请。</text></view>
  <text wx:if="{{loading}}" class="muted">正在加载…</text><button wx:elif="{{hasMore}}" class="text-button" bindtap="more">加载更多</button>
</view>
