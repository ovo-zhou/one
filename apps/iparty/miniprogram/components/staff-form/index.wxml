<import src="../../templates/form-field.wxml" />

<view class="field">
  <template is="field-heading" data="{{label: '姓名 / 昵称', required: true}}" />
  <input class="input" placeholder="填写对外展示的名字" maxlength="30" value="{{form.name}}" disabled="{{disabled}}" data-field="name" bindinput="onInput" />
  <template is="field-error" data="{{message: errors.name}}" />
</view>
<view class="field">
  <template is="field-heading" data="{{label: '岗位名称', required: true}}" />
  <input class="input" placeholder="如：美容师、护理师、家政服务师" maxlength="40" value="{{form.title}}" disabled="{{disabled}}" data-field="title" bindinput="onInput" />
  <template is="field-error" data="{{message: errors.title}}" />
</view>
<view class="field">
  <template is="field-heading" data="{{label: '擅长项目', required: true}}" />
  <input class="input" placeholder="填写擅长的服务项目" maxlength="150" value="{{form.skills}}" disabled="{{disabled}}" data-field="skills" bindinput="onInput" />
  <template is="field-error" data="{{message: errors.skills}}" />
</view>
<view class="field">
  <template is="field-heading" data="{{label: '个人介绍'}}" />
  <textarea class="textarea" placeholder="说说服务特色、工作经验或服务理念" maxlength="600" value="{{form.description}}" disabled="{{disabled}}" data-field="description" bindinput="onInput" />
  <template is="field-error" data="{{message: errors.description}}" />
</view>
