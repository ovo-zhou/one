:host {
  display: block;
}
input,
textarea {
  box-sizing: border-box;
}
.location-picker {
  position: relative;
}
.contact-field {
  display: flex;
  align-items: center;
  box-sizing: border-box;
  height: 88rpx;
  margin-bottom: 18rpx;
  padding: 0 24rpx;
  border: 2rpx solid #e7eadf;
  border-radius: 16rpx;
  background: #fffef9;
}
.contact-label {
  flex-shrink: 0;
  width: 88rpx;
  color: #405343;
  font-size: 26rpx;
  font-weight: 600;
}
.contact-input {
  flex: 1;
  min-width: 0;
  height: 100%;
  padding: 0;
  color: #263b30;
  font-size: 28rpx;
}
.contact-field-last {
  margin-bottom: 30rpx;
}
.location-input {
  background: #f0f0e9;
  color: #737c68;
  pointer-events: none;
}
.location-trigger,
.location-trigger[disabled] {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 1;
  width: 100%;
  margin: 0;
  padding: 0;
  border-radius: 16rpx;
  background: transparent;
}
.privacy-notice {
  margin-top: 20rpx;
  padding: 24rpx;
  border-radius: 12rpx;
  background: #f0eddf;
}
.location-error {
  display: block;
  margin-top: 16rpx;
  color: #a34e3c;
  font-size: 24rpx;
  line-height: 1.7;
}
.hours-field {
  text-align: left;
}
.hours-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #e7eadf;
}
.hours-summary {
  display: flex;
  flex: 1 1 0;
  flex-wrap: wrap;
  align-items: center;
  gap: 8rpx 20rpx;
  min-width: 0;
  font-size: 25rpx;
  text-align: left;
}
.hours-row-actions {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  gap: 18rpx;
  margin-left: auto;
}
.hours-row-actions .hours-link {
  flex: 0 0 auto;
  width: auto;
  min-width: 0;
}
.hours-days {
  word-break: break-all;
}
.hours-range {
  white-space: nowrap;
  color: #737c68;
}
.hours-link {
  flex-shrink: 0;
  margin: 0;
  padding: 8rpx 0;
  font-size: 24rpx;
  line-height: 1.6;
}
.hours-delete {
  color: #919585;
}
.hours-add {
  margin: 12rpx 0 0;
  padding: 12rpx 0;
  text-align: left;
  font-size: 25rpx;
}
.hours-overlay {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  background: rgba(26, 40, 31, 0.4);
}
.hours-dialog {
  box-sizing: border-box;
  width: 100%;
  max-width: 686rpx;
  max-height: 90vh;
  overflow-y: auto;
  padding: 36rpx 28rpx 28rpx;
  border-radius: 24rpx;
  background: #fffef9;
  text-align: left;
}
.hours-dialog-title {
  display: block;
  margin-bottom: 36rpx;
  color: #263b30;
  font-size: 32rpx;
  font-weight: 600;
}
.hours-caption {
  display: block;
  color: #405343;
  font-size: 26rpx;
  font-weight: 600;
}
.hours-weekdays {
  display: flex;
  flex-wrap: nowrap;
  gap: 8rpx;
  margin: 20rpx 0 12rpx;
}
.hours-day {
  flex: 1;
  width: 0;
  min-width: 0;
  margin: 0;
  padding: 0;
  border-radius: 10rpx;
  background: #f0f0e9;
  color: #405343;
  font-size: 23rpx;
  line-height: 72rpx;
  white-space: nowrap;
}
.hours-day-selected {
  background: #244c3c;
  color: #fff;
}
.hours-day[disabled] {
  background: #f4f4ef;
  color: #bbbeb3;
}
.hours-times {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 18rpx;
}
.hours-day-hint {
  display: block;
  color: #919585;
  font-size: 21rpx;
  line-height: 1.7;
}
.hours-time-caption {
  margin-top: 32rpx;
}
.hours-time-label {
  display: block;
  margin-bottom: 12rpx;
  color: #737c68;
  font-size: 23rpx;
}
.hours-picker {
  flex: 1;
  min-width: 0;
}
.hours-time {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 20rpx;
  border: 2rpx solid #e7eadf;
  border-radius: 10rpx;
  font-size: 26rpx;
  text-align: left;
}
.hours-chevron,
.hours-separator {
  color: #919585;
}
.hours-separator {
  margin-top: 42rpx;
}
.hours-editor-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 36rpx;
}
.hours-dialog-button {
  flex: 1;
  width: 0;
  min-width: 0;
  margin: 0;
  font-size: 27rpx;
  line-height: 80rpx;
}
