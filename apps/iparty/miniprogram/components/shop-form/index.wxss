:host {
  display: block;
}
input,
textarea {
  box-sizing: border-box;
}
.input.location-picker {
  display: flex;
  align-items: center;
  width: 100%;
  min-height: calc(40px + 4rpx);
  padding-right: 12rpx;
  background: #f0f0e9;
}
.location-input {
  flex: 1 1 0;
  min-width: 0;
  height: 100%;
  padding: 0;
  color: #737c68;
  font-size: 28rpx;
}
.location-picker .location-action {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: flex-end;
  width: auto;
  min-width: 72rpx;
  margin: 0 0 0 auto;
  padding: 0 12rpx;
  font-size: 24rpx;
  font-weight: 600;
  white-space: nowrap;
}
.location-picker .location-action[disabled] {
  background: transparent;
  color: #737c68;
}
.location-pin {
  position: relative;
  width: 28rpx;
  height: 28rpx;
  margin: 0 3rpx 5rpx;
  border: 3rpx solid currentColor;
  border-radius: 50% 50% 50% 0;
  transform: rotate(-45deg);
}
.location-pin::after {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: currentColor;
  content: "";
  transform: translate(-50%, -50%);
}
.contact-field + .contact-field {
  margin-top: 18rpx;
}
.privacy-notice {
  margin-top: 20rpx;
  padding: 24rpx;
  border-radius: 12rpx;
  background: #f0eddf;
}
.hours-field {
  text-align: left;
}
.hours-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 8rpx 0;
  border-bottom: 2rpx solid #e7eadf;
}
.hours-summary {
  display: flex;
  flex: 1 1 0;
  flex-wrap: wrap;
  align-items: center;
  gap: 8rpx 20rpx;
  min-width: 0;
  font-size: 25rpx;
  text-align: left;
}
.hours-row-actions {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  gap: 18rpx;
  margin-left: auto;
}
.hours-row-actions .hours-link {
  flex: 0 0 auto;
  width: auto;
  min-width: 0;
}
.hours-days {
  word-break: break-all;
}
.hours-range {
  white-space: nowrap;
  color: #737c68;
}
.hours-link {
  flex-shrink: 0;
  margin: 0;
  font-size: 24rpx;
}
.hours-row-actions .hours-delete {
  color: #b14c38;
}
.hours-field .hours-add {
  display: inline-flex;
  align-items: center;
  width: auto;
  margin: 12rpx auto 0 0;
  text-align: left;
  font-size: 25rpx;
}
.hours-overlay {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  background: rgba(26, 40, 31, 0.4);
}
.hours-dialog {
  box-sizing: border-box;
  width: 100%;
  max-width: 686rpx;
  max-height: 90vh;
  overflow-y: auto;
  padding: 36rpx 28rpx 28rpx;
  border-radius: 24rpx;
  background: #fffef9;
  text-align: left;
}
.hours-dialog-title {
  display: block;
  margin-bottom: 36rpx;
  color: #263b30;
  font-size: 32rpx;
  font-weight: 600;
}
.hours-weekdays {
  display: flex;
  flex-wrap: nowrap;
  gap: 8rpx;
}
.hours-day {
  flex: 1;
  width: 0;
  min-width: 0;
  margin: 0;
  padding: 0;
  border-radius: 10rpx;
  background: #f0f0e9;
  color: #405343;
  font-size: 23rpx;
  white-space: nowrap;
}
.hours-day-selected {
  background: #244c3c;
  color: #fff;
}
.hours-day[disabled] {
  background: #f4f4ef;
  color: #bbbeb3;
}
.hours-times {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 32rpx;
}
.hours-picker {
  flex: 1;
  min-width: 0;
}
.hours-time {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 20rpx;
  border: 2rpx solid #e7eadf;
  border-radius: 10rpx;
  font-size: 26rpx;
  text-align: left;
}
.hours-chevron,
.hours-separator {
  color: #919585;
}
.hours-separator {
  margin-top: 42rpx;
}
.hours-editor-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 36rpx;
}
.hours-dialog-button {
  flex: 1;
  width: 0;
  min-width: 0;
  margin: 0;
  font-size: 27rpx;
}
